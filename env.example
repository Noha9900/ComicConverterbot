# Get API_ID / API_HASH from https://my.telegram.org (log in -> API development tools)
API_ID=1234567
API_HASH=your_api_hash_here

# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=123456789:AAExampleTokenGoesHere

# Comma-separated numeric Telegram user IDs allowed to use /admin and /stats.
# Get your own id from @userinfobot. Required for the admin panel to work at all.
ADMIN_IDS=123456789

# --- Optional overrides (defaults shown) ------------------------------------
DOWNLOAD_DIR=downloads
OUTPUT_DIR=output
DATA_DIR=data

MULTIVOLUME_AUTO_FINALIZE_SECONDS=20
IMAGE_BATCH_AUTO_FINALIZE_SECONDS=25
PROGRESS_EDIT_INTERVAL=1.5

# Delivered files (and the bot's own copy of the message) are deleted after
# this many hours. Disk-side cleanup runs every CLEANUP_INTERVAL_MINUTES.
FILE_TTL_HOURS=2
CLEANUP_INTERVAL_MINUTES=10

# 0 = unlimited. Admins can change both at runtime via /admin, no restart needed.
DEFAULT_RATE_LIMIT_PER_MIN=0
DEFAULT_DAILY_QUOTA_MB=0

# Ask for confirmation before downloading anything bigger than this.
FILE_SIZE_WARNING_MB=300

DEFAULT_LANGUAGE=en

# Lightweight aiohttp server exposing GET /health (always) and, if
# WEBHOOK_MODE=true, POST /notify?secret=... for external triggers.
# This is NOT Telegram webhook delivery -- Pyrogram uses MTProto, not the
# classic Bot-API HTTP model. See utils/webhook_server.py for details.
ENABLE_HEALTH_SERVER=true
HEALTH_CHECK_PORT=8080
WEBHOOK_MODE=false
WEBHOOK_SECRET=

# Leave empty to log to console only.
LOG_FILE=
